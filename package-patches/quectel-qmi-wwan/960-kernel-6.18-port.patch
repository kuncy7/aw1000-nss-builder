 }
+#else
+/* 6.18: usbnet's bottom half migrated from a tasklet (dev->bh) to a
+ * work_struct (dev->bh_work). We hijack it the same way: save the original
+ * work function, install ours, chain to the original, then wake the qmap
+ * TX queue for UL aggregation flow control. */
+static void usbnet_bh(struct work_struct *work) {
+	struct usbnet *dev = container_of(work, struct usbnet, bh_work);
+	struct qmi_wwan_state *info = (struct qmi_wwan_state *)&dev->data;
+	sQmiWwanQmap *pQmapDev = (sQmiWwanQmap *)info->unused;
+
+	if (pQmapDev && pQmapDev->usbnet_bh_func)
+		pQmapDev->usbnet_bh_func(work);
+
+	if (pQmapDev && !netif_queue_stopped(dev->net)) {
+		qmap_wake_queue(pQmapDev);
+	}
+}
+#endif
 
 static void rmnet_usb_tx_wake_queue(unsigned long data) {
