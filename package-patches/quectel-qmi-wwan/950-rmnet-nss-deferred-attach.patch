+/* NSS data-plane deferred attach.
+ *
+ * nss_cb->nss_create() only succeeds once the NSS data plane is armed (the
+ * qca-ppe-nss fw_mask has been written and the firmware booted). On the EDMA
+ * stack arming is an explicit runtime step that can happen after the modem has
+ * already enumerated and created its qmap netdev, so a single attach attempt at
+ * device-creation time races the arming and usually loses ("Device will not use
+ * NSS path: -1"), leaving rmnet off the NSS path for the device's whole life.
+ *
+ * Rather than forcing a boot ordering (or a driver rebind, as ath11k needs), we
+ * let the qmap netdev self-attach: try once at creation and, if NSS is not up
+ * yet, retry from a delayed work until it is (bounded). This is timing
+ * independent and never tears down the data call; the attach call is the
+ * existing, safe nss_create path, so a failed attempt is a harmless no-op. */
+#define QMAP_NSS_RETRY_MAX	30	/* give up after ~60s */
+#define QMAP_NSS_RETRY_MS	2000
+
+static int qmap_nss_attach(struct net_device *qmap_net)
+{
+	struct qmap_priv *priv = netdev_priv(qmap_net);
+	int rc;
+
+	if (!nss_cb || priv->use_qca_nss)
+		return 0;
+
+	rc = nss_cb->nss_create(qmap_net);
+	if (rc)
+		return rc;
+
+	priv->use_qca_nss = 1;
+	rtnl_lock();
+	netdev_rx_handler_register(qmap_net, qca_nss_rx_handler, NULL);
+	rtnl_unlock();
+	return 0;
+}
+
+static void qmap_nss_retry_work(struct work_struct *work)
+{
+	struct qmap_priv *priv = container_of(to_delayed_work(work),
+					      struct qmap_priv, nss_retry_work);
+	struct net_device *qmap_net = priv->self_dev;
+
+	if (qmap_nss_attach(qmap_net) == 0) {
+		netdev_info(qmap_net, "NSS context created (deferred, after %d retr%s)\n",
+			    priv->nss_retry_count,
+			    priv->nss_retry_count == 1 ? "y" : "ies");
+		return;
+	}
+
+	if (++priv->nss_retry_count < QMAP_NSS_RETRY_MAX)
+		schedule_delayed_work(&priv->nss_retry_work,
+				      msecs_to_jiffies(QMAP_NSS_RETRY_MS));
+	else
+		netdev_warn(qmap_net,
+			    "NSS data plane still down after %d retries; staying on host path\n",
+			    priv->nss_retry_count);
+}
