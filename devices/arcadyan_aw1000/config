#
# EDMA-NSS full build for the Arcadyan AW1000 (IPQ8072, 1 GB RAM).
#
# Package/feature parity with the qosmio production build (main branch), but
# built against JuliusBairaktaris/openwrt-nss-edma (nss-edma-rework) + the
# JuliusBairaktaris/nss-packages (edma-nss) feed: NSS hardware offload running
# on OpenWrt main's upstream qca-edma/qca-ppe ethernet drivers.
#
# Produces BOTH the …-initramfs-uImage.itb (USB/RAM boot, safe) and the
# standard squashfs sysupgrade images. Flashing the sysupgrade to NAND
# replaces the qosmio production system — RAM boot first is recommended.
#
# Boot model (Julius-philosophy, turnkey like qosmio): the nss-tools package
# ships /etc/init.d/nss (START=99) which runs the tree's /usr/sbin/nss-up:
# fw_mask arm behind the qca-ppe-nss deferred-probe gate (drivers wait for the
# arm, so no boot races by design), then bridge-mgr/pppoe modprobes, ath11k
# nss_offload flip + radio rebind + qca-nss-pbuf + NSS core freq pinning.
# Toggle: uci set nss.general.enabled='0' (or the luci-app-nss GUI).
# The modem dials via netifd (proto quectel); AT+CFUN=1 is built into the
# patched quectel-cm and rmnet self-attaches to NSS via the deferred-attach
# patch (prepare-build.sh 2a-bis). /usr/sbin/modem-up stays as a manual tool.
# rc.local only keeps ssh-moduli hardening + the RAM-boot Wi-Fi fallback.
#
# Parity notes vs qosmio (updated 2026-07-03):
#   - bridge-mgr + qca-mcs now EXIST on the Julius tree (QSDK 14.0) and are
#     enabled below. qca-mcs must resolve from the nss feed, not wwan (the
#     wwan feed carries a stale 12.5 copy that fails on 6.18) — guarded in
#     prepare-build.sh.
#   - kmod-nat46 + 464xlat: ENABLED. nat46 MAP-T export API is upstream in the
#     Julius tree; kmod-qca-nss-drv-map-t (the NSS MAP-T connmgr) is injected
#     into qca-nss-clients (prepare-build.sh "2c"). NSS-offloaded CLAT — the
#     qosmio image only does software CLAT.
#     Both software CLAT and NSS hardware offload of the translation are built.
#   - luci-mod-status-nss (qosmio packages-extra; kept below — drop if it
#     breaks the build)
#

## Target Platform
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_arcadyan_aw1000=y

## RAM-boot image (…-initramfs-uImage.itb) in addition to the sysupgrade images.
CONFIG_TARGET_ROOTFS_INITRAMFS=y

## Mark the image distinctly so it can't be confused with the qosmio production
## build: the filename becomes openwrt-edma-… and the banner / /etc/openwrt_release
## report "OpenWrt-EDMA".
CONFIG_VERSION_DIST="OpenWrt-EDMA"

## Disable Ath10k (AW1000 has none)
CONFIG_ATH10K-CT_LEDS=n
CONFIG_PACKAGE_ath10k-board-qca9887=n
CONFIG_PACKAGE_ath10k-firmware-qca9887=n
CONFIG_PACKAGE_ath10k-firmware-qca9887-ct=n
CONFIG_PACKAGE_kmod-ath10k-ct-smallbuffers=n

## Compiler and Toolchain Optimization
CONFIG_BINUTILS_USE_VERSION_2_45=y
CONFIG_DEVEL=y
CONFIG_GCC_USE_GRAPHITE=y
CONFIG_GCC_USE_VERSION_15=y
CONFIG_TARGET_OPTIMIZATION="-O2 -pipe -mcpu=cortex-a53+crc+crypto"
CONFIG_TARGET_OPTIONS=y
CONFIG_TOOLCHAINOPTS=y
CONFIG_USE_GC_SECTIONS=y
CONFIG_USE_LTO=y
CONFIG_USE_MKLIBS=y
CONFIG_USE_MOLD=y
CONFIG_ZLIB_OPTIMIZE_SPEED=y
CONFIG_ZSTD_OPTIMIZE_O3=y
# CONFIG_CCACHE is not set

## Kernel Build Options
CONFIG_BUILD_PATENTED=y
CONFIG_EXPERIMENTAL=y

# Hardening build options
CONFIG_GCC_DEFAULT_PIE=y
CONFIG_GCC_DEFAULT_SSP=y
CONFIG_PKG_CHECK_FORMAT_SECURITY=y
CONFIG_PKG_ASLR_PIE_ALL=y
CONFIG_PKG_CC_STACKPROTECTOR_ALL=y
CONFIG_KERNEL_CC_STACKPROTECTOR_STRONG=y
CONFIG_PKG_FORTIFY_SOURCE_3=y
CONFIG_PKG_RELRO_FULL=y
CONFIG_USE_SECCOMP=y

## SSH Server Configuration
CONFIG_PACKAGE_dropbear=n
CONFIG_PACKAGE_openssh-moduli=y
CONFIG_PACKAGE_openssh-server=y
CONFIG_PACKAGE_openssh-sftp-server=y

## SSL and Cryptography Configuration
CONFIG_LUA_ECO_MBEDTLS=n
CONFIG_LUA_ECO_OPENSSL=y
CONFIG_OPENSSL_OPTIMIZE_SPEED=y
CONFIG_PACKAGE_apk-mbedtls=n
CONFIG_PACKAGE_apk-openssl=y
CONFIG_PACKAGE_libopenssl=y
CONFIG_PACKAGE_libopenssl-oqsprovider=y
CONFIG_PACKAGE_libustream-mbedtls=n
CONFIG_PACKAGE_libustream-openssl=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_luci-app-bcp38=y

## Additional Packages and Utilities
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_openssh-client=y
CONFIG_PACKAGE_openssh-sftp-client=y
CONFIG_PACKAGE_pigz=y
CONFIG_PACKAGE_rsync=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_xz=y
CONFIG_HTOP_LMSENSORS=n
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_LIBCURL_MBEDTLS=n
CONFIG_LIBCURL_OPENSSL=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_luci-mod-status-nss=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_sqm-scripts-nss=y

## Redundant Default Packages
CONFIG_PACKAGE_kmod-phy-aquantia=n
CONFIG_PACKAGE_wpad-basic-mbedtls=n
CONFIG_PACKAGE_luci-app-attendedsysupgrade=n
CONFIG_PACKAGE_attendedsysupgrade-common=n

# Disable unnecessary debugging for Wi-Fi driver.
CONFIG_ATH11K_DEBUGFS_HTT_STATS=n
CONFIG_ATH11K_DEBUGFS_STA=n
# Disables thermal throttling support for ath11k.
CONFIG_ATH11K_THERMAL=n

## ---- EDMA-NSS variant (Julius' config.edma-nss + the verified v2 deltas) ----

## NSS data plane + connection offload. kmod-qca-ppe-nss (the data-plane glue)
## is pulled in by kmod-qca-nss-drv; listed explicitly for clarity.
CONFIG_PACKAGE_kmod-qca-ppe-nss=y
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_NSS_FIRMWARE_VERSION_12_5=y
CONFIG_NSS_MEM_PROFILE_HIGH=y
CONFIG_NSS_DRV_C2C_ENABLE=y
CONFIG_NSS_DRV_IGS_ENABLE=y
CONFIG_NSS_DRV_IPV6_ENABLE=y
CONFIG_NSS_DRV_PPPOE_ENABLE=y
CONFIG_NSS_DRV_SHAPER_ENABLE=y
CONFIG_NSS_DRV_VIRT_IF_ENABLE=y
CONFIG_NSS_DRV_WIFIOFFLOAD_ENABLE=y
CONFIG_NSS_DRV_WIFI_EXT_VDEV_ENABLE=y

## ath11k NSS Wi-Fi offload support compiled in; the radios boot host-mode and
## the nss service (nss-tools) flips nss_offload + rebinds them at START=99.
CONFIG_ATH11K_NSS_SUPPORT=y
CONFIG_ATH11K_NSS_MESH_SUPPORT=y
CONFIG_PACKAGE_MAC80211_NSS_SUPPORT=y

## Julius arming + QoS stack (turnkey boot, GUI control). nss-tools ships
## /etc/init.d/nss + /usr/sbin/nss-up (fw arm, bridge/wifi offload, core
## pinning); nssqos = DSCP marking / NSS fast-lane; LuCI apps for both.
## nss-tools hard-depends on kmod-qca-mcs (multicast snooping, QSDK 14.0).
CONFIG_PACKAGE_nss-tools=y
CONFIG_PACKAGE_nssqos=y
CONFIG_PACKAGE_luci-app-nss=y
CONFIG_PACKAGE_luci-app-nssqos=y

## Bridge offload (nss-bridge-mgr, first enabled 2026-07-03) + multicast.
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y
CONFIG_PACKAGE_kmod-qca-mcs=y

## NSS qdisc/SQM (nss-edma.qos) + the SQM LuCI app
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y
CONFIG_PACKAGE_kmod-qca-nss-drv-igs=y

## NSS MAP-T connection manager (464xlat/MAP-T hardware offload). Subpackage
## injected into qca-nss-clients by prepare-build.sh "2c"; drives the nat46
## MAP-T API from "2b".
CONFIG_PACKAGE_kmod-qca-nss-drv-map-t=y

## ---- Modem 5G: RMNET przez NSS (wwan feed = qosmio nss-packages) ----
CONFIG_NSS_DRV_RMNET_ENABLE=y
CONFIG_PACKAGE_kmod-rmnet-nss=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan-quectel=y
CONFIG_PACKAGE_quectel-cm=y
CONFIG_PACKAGE_luci-proto-quectel=y

## WireGuard
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y

## USB storage
CONFIG_PACKAGE_kmod-scsi-core=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y

## Filesystems (USB drives)
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-f2fs=y

## USB CDC ACM (modemy USB)
CONFIG_PACKAGE_kmod-usb-acm=y

## Crash logs
CONFIG_PACKAGE_kmod-pstore=y
CONFIG_PACKAGE_kmod-ramoops=y

## MTD flash write
CONFIG_PACKAGE_kmod-mtd-rw=y

## GRE IPv6
CONFIG_PACKAGE_kmod-gre6=y

## USB support — VERIFIED FIX: Julius' base disables xhci, which kills the
## whole USB bus (no root hub: no boot pendrive, no modem). Must stay =y.
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb-dwc3=y
CONFIG_PACKAGE_kmod-usb-dwc3-qcom=y
CONFIG_PACKAGE_kmod-usb-xhci-hcd=y
CONFIG_PACKAGE_kmod-usb3=y

## Obsługa dongla Sonoff (CP210x USB-to-UART)
CONFIG_PACKAGE_kmod-usb-serial-cp210x=y
CONFIG_PACKAGE_ser2net=y

## cellled (modemfeed)
CONFIG_PACKAGE_cellled=y
CONFIG_PACKAGE_luci-app-cellled=y

## gSpotx2f
CONFIG_PACKAGE_luci-app-cpu-perf=y
CONFIG_PACKAGE_luci-app-cpu-status=y

## 4IceG extra
CONFIG_PACKAGE_luci-app-3ginfo-lite=y
CONFIG_PACKAGE_luci-app-lite-watchdog=y

## obsy
CONFIG_PACKAGE_sysinfo=y

## quectel-timesync (standardowy feed packages)
CONFIG_PACKAGE_quectel-timesync=y

## Pakiety 4IceG
CONFIG_PACKAGE_luci-app-modemdata=y
CONFIG_PACKAGE_luci-app-modemband=y
CONFIG_PACKAGE_luci-app-sms-tool-js=y
CONFIG_PACKAGE_luci-app-atinout=y
CONFIG_PACKAGE_sms-tool=y
CONFIG_PACKAGE_comgt=y

## BusyBox
# Use CONFIG_BUSYBOX_CONFIG_* (the build-driving symbol). CONFIG_BUSYBOX_DEFAULT_*
# is prompt-less and `make defconfig` regenerates it from Kconfig, so it is inert.
CONFIG_BUSYBOX_CONFIG_FEATURE_SYSLOG_INFO=y
CONFIG_BUSYBOX_CONFIG_FEATURE_REVERSE_SEARCH=y

## 464xlat CLAT (IPv4-over-IPv6) — re-enabled. qca-nss-ecm enables MAP-T whenever
## kmod-nat46 is selected and then needs the QCA MAP-T nat46 API (is_map_t_dev,
## staged headers). prepare-build.sh adds the QCA "Export APIs for acceleration"
## patch (ported onto the current nat46, no old-version pin) + a Build/InstallDev,
## so this builds. Tier 1: software CLAT (translation on nat46.ko). Tier 2 (NSS
## hardware offload of the translation) additionally needs the qca-nss-clients
## map-t connmgr subpackage — not enabled yet.
CONFIG_PACKAGE_kmod-nat46=y
CONFIG_PACKAGE_464xlat=y
