#!/bin/sh
# Arm the NSS data plane on the AW1000 and load ECM. Run once at boot (rc.local).
#
# Mask 0x5e = ports lan1,2,3,4 (bits 1-4) + wan (bit 6). Port index 5 does NOT
# exist on the AW1000 (the 2.5G WAN is port 6). The mask MUST cover a port at the
# first non-zero fw_mask write (when the firmware boots): a port armed LATER gets
# armed=1 but never 'overridden'/'started' (no VSI) — that is why lan1 linked at
# 1Gbps but passed no traffic under the old 0x1c mask.
#
# Verified live on hardware (v2 image, 2026-06-12): all if_num 1-4+6 started=1.
set -e
FWM=/sys/kernel/debug/qca-ppe-nss/fw_mask

modprobe qca-ppe-nss 2>/dev/null || true
[ "$(cat $FWM 2>/dev/null)" = "0x0" ] || { echo "already armed or glue missing - reboot first"; exit 1; }
modprobe qca-nss-drv 2>/dev/null || true

echo 0x5e > $FWM
[ "$(cat $FWM)" = "0x5e" ] || { echo "arming failed, fw not booted"; exit 1; }
sleep 6
grep -E "if_num [1-6]:" /sys/kernel/debug/qca-ppe-nss/status

# ECM connection offload (NAT/PPPoE). The init refuses to load unless the NSS
# data plane is up, which it now is.
sysctl -w net.netfilter.nf_conntrack_events=1 2>/dev/null || true
sysctl -w net.netfilter.nf_conntrack_tcp_no_window_check=1 2>/dev/null || true
/etc/init.d/qca-nss-ecm start 2>/dev/null || true

echo "NSS armed 0x5e + ECM up."
