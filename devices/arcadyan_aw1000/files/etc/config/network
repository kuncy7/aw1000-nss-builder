config interface 'loopback'
	option device 'lo'
	option proto 'static'
	list ipaddr '127.0.0.1/8'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'lan1'
	list ports 'lan2'
	list ports 'lan3'
	list ports 'lan4'
	list ports 'wan'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	list ipaddr '192.168.21.1/24'
	option ip6assign '60'

# === PROFIL A: wwand + QMAP v5 + NSS (aktywny, domyslny) ==================
# Zwalidowane na HW 2026-09-09: `rmnet_nss - QMAP v5`, ping 5/5,
# ECM ipv4 accelerated_count 25/29 przy 5 klientach WiFi. Czyli wwand dialuje
# I zachowuje offload NSS - to jedyny powod, dla ktorego vendorowa sciezka
# QMAP w ogole tu jest.
#
# Wymagane trzy rzeczy i kazda ma swoja historie (szczegoly:
# /home/stacho/moje/AW1000/wwand-migracja.md, pulapki 6/10/11):
#   * `netdev wwan0` w sekcji modemu - vendorowy netdev danych, NIE l3.
#   * `mux_id 1` na interfejsie - bez niego lista kanalow jest pusta i
#     datapath degraduje sie do raw-IP na rodzicu, ktory jest w ramkowaniu
#     QMAP, wiec nie przejdzie ani jeden pakiet. Od wwand r65 to blad, nie
#     cicha degradacja.
#   * BRAK `qmap_version` - datapath wyprowadza v5 sam z `qmap_size`
#     (31744 = 31 KB = wiersz sdx55 w tablicy qmi_wwan_q). Recznie ustawiona
#     wartosc i tak nie podniesie drabiny, ktora deklaruje datapath.
#
# Wymaga wwand >= r65 (commit 2a26903). Starsze wersje: patrz PROFIL A-legacy.
config wwand_modem 'm0'
	option device '/dev/cdc-wdm0'
	option netdev 'wwan0'
	option mux 'rmnet_nss'

config interface 'wan'
	option proto 'wwand'
	option modem 'm0'
	option apn 'internet'
	option pdp_type 'ipv4'
	option auth 'none'
	option mux_id '1'

# === PROFIL A-legacy: quectel-cm (droga odwrotu) ===========================
# quectel-cm zostaje w obrazie. Zeby wrocic: zakomentowac PROFIL A powyzej,
# odkomentowac ponizsze, `/etc/init.d/wwand reload && /etc/init.d/network restart`.
#
# config interface 'wan'
# 	option proto 'quectel'
# 	option device '/dev/cdc-wdm0'
# 	option pdptype 'ipv4'
# 	option apn 'internet'
# 	option auth 'none'
# 	option delay '15'

# === PROFIL B: IPv6-only + native 464xlat (Orange PL) ======================
# Validated on AW1000 (RG500Q-EA / Orange PL). No ResetFactory needed: the
# patched quectel-cm (r5) wins the CGACT re-activation race internally.
# 'multiplexing 1' is REQUIRED so quectel.sh dials IPv6-only as
# `quectel-cm -6 -n 2 -m 1` (v6mux=1 for qmap_mode=1).
#
# CLAT is NATIVE: do NOT add an explicit 'clat' interface. With pdptype ipv6
# odhcp6c brings up wan_6 (dhcpv6) and auto-spawns a '464xlat' interface
# (wan_6_4); 464xlatcfg discovers the NAT64 prefix via the modem's DNS64.
# IMPORTANT: do NOT pin lan 'dns' to a non-DNS64 resolver (e.g. an upstream
# router) — that breaks the prefix discovery and makes wan_6_4 flap. dnsmasq
# forwarding to the modem's Orange DNS64 (default) is what makes it work.
# An explicit clat with `tunlink 'wan'` does NOT work (wan's l3_device is wwan0,
# which has no global IPv6 -> NO_DEVICE); if you ever need an explicit one use
# `tunlink 'wan_6'`.
# Aby uzyc: zakomentowac caly Profil A powyzej, odkomentowac ponizsze,
# nastepnie: /etc/init.d/network restart
#
# config interface 'wan'
# 	option proto 'quectel'
# 	option multiplexing '1'
# 	option device '/dev/cdc-wdm0'
# 	option pdptype 'ipv6'
# 	option apn 'internetipv6'
# 	option auth 'none'
# 	option delay '15'
# ===========================================================================
