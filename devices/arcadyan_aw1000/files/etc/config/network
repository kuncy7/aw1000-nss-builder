config interface 'loopback'
	option device 'lo'
	option proto 'static'
	list ipaddr '127.0.0.1/8'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'lan1'
	list ports 'lan2'
	list ports 'lan3'
	list ports 'lan4'
	list ports 'wan'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	list ipaddr '192.168.21.1/24'
	option ip6assign '60'

config interface 'wan'
	option proto 'quectel'
	option device '/dev/cdc-wdm0'
	option apn 'internet'
	option pdptype 'ipv4'
