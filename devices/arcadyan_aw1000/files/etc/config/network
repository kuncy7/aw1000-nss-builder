config interface 'loopback'
	option device 'lo'
	option proto 'static'
	list ipaddr '127.0.0.1/8'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'lan1'
	list ports 'lan2'
	list ports 'lan3'
	list ports 'lan4'
	list ports 'wan'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	list ipaddr '192.168.21.1/24'
	option ip6assign '60'

# === PROFIL A: IPv4-only (aktywny, domyslny) ===============================
# Bezpieczny, znany, utrzymuje lacznosc. Zaden ResetFactory niepotrzebny.
config interface 'wan'
	option proto 'quectel'
	option device '/dev/cdc-wdm0'
	option pdptype 'ipv4'
	option apn 'internet'
	option auth 'none'
	option delay '15'

# === PROFIL B: IPv6-only + 464xlat (recepta alula) =========================
# Validated on AW1000 (RG500Q-EA / Orange PL). No ResetFactory needed: the
# patched quectel-cm (r5) wins the CGACT re-activation race internally.
# 'multiplexing 1' is REQUIRED so quectel.sh dials IPv6-only as
# `quectel-cm -6 -n 2 -m 1` (v6mux=1 for qmap_mode=1) — without it the dial
# uses the wrong mux/index and never establishes.
# Aby uzyc: zakomentowac caly Profil A powyzej, odkomentowac ponizsze,
# nastepnie: /etc/init.d/network restart
#
# config interface 'wan'
# 	option proto 'quectel'
# 	option multiplexing '1'
# 	option device '/dev/cdc-wdm0'
# 	option pdptype 'ipv6'
# 	option apn 'internetipv6'
# 	option auth 'none'
# 	option delay '15'
#
# config interface 'clat'
# 	option proto '464xlat'
# 	option tunlink 'wan'
# 	option ip6prefix '64:ff9b::/96'
# ===========================================================================
