config interface 'loopback'
	option device 'lo'
	option proto 'static'
	list ipaddr '127.0.0.1/8'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'lan1'
	list ports 'lan2'
	list ports 'lan3'
	list ports 'lan4'
	list ports 'wan'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	list ipaddr '192.168.21.1/24'
	option ip6assign '60'

# === PROFIL A: IPv4-only (aktywny, domyslny) ===============================
# Bezpieczny, znany, utrzymuje lacznosc. Zaden ResetFactory niepotrzebny.
config interface 'wan'
	option proto 'quectel'
	option device '/dev/cdc-wdm0'
	option pdptype 'ipv4'
	option apn 'internet'
	option auth 'none'
	option delay '15'

# === PROFIL B: IPv6-only + 464xlat (recepta alula) — OPCJA (domyslny = A) =====
# ResetFactory NIE jest juz potrzebny: zalatany quectel-cm (PKG_RELEASE 5,
# package-patches/quectel-cm/950-ipv6-cgact-race.patch) wygrywa wyscig CGACT na
# split-PDN Orange (deaktywuje auto-aktywowany PDN IPv6 i ponawia START az trafi
# w okno <2s), wiec verbose 241 nie blokuje polaczenia. Modem IPv6-only -> IPv4
# klientow idzie przez 464xlat (CLAT, NAT64/DNS64).
# multiplexing '1' => quectel.sh dzwoni `-m 1` (wwan0_1, muxid 0x81 — jedyny mux
# qmap_mode=1) dla IPv6-only.
# CLAT JEST AUTO-SPAWNOWANY: odhcp6c sam tworzy dynamiczny interfejs wan_6_4
# (464-wan_6_4) gdy wan_6 jest dhcpv6 -> NIE dawac wlasnego `config interface
# clat` (zbedny, leci up:false bo prefiks jest na wan_6 nie wan; explicit+auto
# moga flapowac). Wystarczy ponizszy wan.
# Aby uzyc: zakomentowac caly Profil A powyzej, odkomentowac ponizsze, potem
# ZREBOOTOWAC (NIE `network restart`! Na cieplym modemie Orange trzyma PDN IPv6
# i wyscig CGACT nie wygrywa -> 241 w petli, a Profil A juz zdjety = brak lacza;
# tylko cold boot daje czyste okno).
#
# config interface 'wan'
# 	option proto 'quectel'
# 	option device '/dev/cdc-wdm0'
# 	option pdptype 'ipv6'
# 	option apn 'internetipv6'
# 	option auth 'none'
# 	option multiplexing '1'
# 	option delay '15'
