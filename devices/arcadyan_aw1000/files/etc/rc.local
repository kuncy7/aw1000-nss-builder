# Put your custom commands here that should be executed once
# the system init finished. By default this file does nothing.

# NSS bring-up is NOT done here anymore (Julius-philosophy boot model):
# the nss-tools package ships /etc/init.d/nss (START=99) which arms the
# data plane and does the ath11k nss_offload flip + radio rebind + pbuf.
# Toggle: uci set nss.general.enabled='0'. The modem dials via netifd
# (proto quectel, AT+CFUN=1 inside the patched quectel-cm); rmnet attaches
# to NSS via the deferred-attach patch. /usr/sbin/modem-up remains as a
# manual recovery tool only.

# ssh moduli hardening (drop weak DH groups).
[ -f /etc/ssh/moduli ] && {
	awk '$5 >= 3071' /etc/ssh/moduli > /etc/ssh/moduli.safe
	mv /etc/ssh/moduli.safe /etc/ssh/moduli
}

# Wi-Fi fallback for RAM boot: on initramfs every boot is a first boot and
# 10-wifi-setup (uci-defaults) can run before /etc/config/wireless exists.
# Apply the same production settings here if they did not stick.
if [ -f /etc/config/wireless ] && [ "$(uci -q get wireless.default_radio0.disabled)" != "0" ]; then
	uci batch <<'EOF'
set wireless.radio0.disabled='0'
set wireless.default_radio0.disabled='0'
set wireless.default_radio0.ssid='MiFi_5G'
set wireless.default_radio0.encryption='psk2'
set wireless.default_radio0.key='12345678'
set wireless.radio1.disabled='0'
set wireless.default_radio1.disabled='0'
set wireless.default_radio1.ssid='MiFi'
set wireless.default_radio1.encryption='psk2'
set wireless.default_radio1.key='12345678'
EOF
	uci commit wireless
	wifi reload
fi

exit 0
