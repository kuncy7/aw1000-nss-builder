# Put your custom commands here that should be executed once
# the system init finished. By default this file does nothing.

# ssh moduli hardening (drop weak DH groups).
[ -f /etc/ssh/moduli ] && {
	awk '$5 >= 3071' /etc/ssh/moduli > /etc/ssh/moduli.safe
	mv /etc/ssh/moduli.safe /etc/ssh/moduli
}

# 1. Arm the NSS data plane (lan1-4 + wan = 0x5e) + ECM, before the modem.
#    On qosmio NSS comes up by itself (nss-dp is the ethernet driver); on the
#    EDMA tree arming the fw_mask at boot is our job.
/usr/sbin/nss-up >/tmp/nss-up.log 2>&1 || logger -t nss-up "NSS bring-up failed, see /tmp/nss-up.log"

# 2. Wi-Fi fallback for RAM boot: on initramfs every boot is a first boot and
#    10-wifi-setup (uci-defaults) can run before /etc/config/wireless exists.
#    Apply the same production settings here if they did not stick.
if [ -f /etc/config/wireless ] && [ "$(uci -q get wireless.default_radio0.disabled)" != "0" ]; then
	uci batch <<'EOF'
set wireless.radio0.disabled='0'
set wireless.default_radio0.disabled='0'
set wireless.default_radio0.ssid='MiFi_5G'
set wireless.default_radio0.encryption='psk2'
set wireless.default_radio0.key='12345678'
set wireless.radio1.disabled='0'
set wireless.default_radio1.disabled='0'
set wireless.default_radio1.ssid='MiFi'
set wireless.default_radio1.encryption='psk2'
set wireless.default_radio1.key='12345678'
EOF
	uci commit wireless
	wifi reload
fi

# 3. Wi-Fi NSS offload (wifili). NSS is armed (step 1) but ath11k loaded in host
#    mode at boot, so flip nss_offload and rebind the radio to re-probe with
#    wifili attached, then (re)start qca-nss-pbuf. Julius's documented bring-up;
#    a Wi-Fi client's forwarded traffic then stays on the NSS path (wifili -> NSS).
#    NOTE: the radios renumber after the rebind (e.g. phy0/phy1 -> phy2/phy3) —
#    expected; check iwinfo / hostapd, not fixed phyN names.
if [ -r /sys/module/ath11k/parameters/nss_offload ]; then
	{
		echo 1 > /sys/module/ath11k/parameters/nss_offload
		wifi down
		echo c000000.wifi > /sys/bus/platform/drivers/ath11k/unbind
		sleep 1
		echo c000000.wifi > /sys/bus/platform/drivers/ath11k/bind
		sleep 2
		/etc/init.d/qca-nss-pbuf restart
		wifi up
	} >/tmp/wifi-nss.log 2>&1
fi

# 4. Bring the modem online: AT+CFUN=1, then netifd dials wan (proto quectel).
#    The qmi_wwan_q reload in modem-up gives an immediate rmnet->NSS attach; the
#    deferred-attach patch (prepare-build.sh 2a-bis) is the timing-safe fallback.
/usr/sbin/modem-up >/tmp/modem-up.log 2>&1 &

exit 0
