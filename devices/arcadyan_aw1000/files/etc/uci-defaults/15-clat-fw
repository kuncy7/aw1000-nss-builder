#!/bin/sh
# Pre-provision: add the 'clat' interface to the 'wan' firewall zone so that
# switching network to Profil B (IPv6-only + 464xlat) needs no firewall edit.
# The wan zone already has masq=1, which is what CLAT (nat46) requires for LAN
# IPv4. Harmless in Profil A: the clat interface simply does not exist.
. /lib/functions.sh

add_clat_to_wan() {
	local cfg="$1" name
	config_get name "$cfg" name
	[ "$name" = "wan" ] || return 0
	uci -q get "firewall.$cfg.network" | grep -qw clat && return 0
	uci add_list "firewall.$cfg.network=clat"
	CLAT_FW_CHANGED=1
}

config_load firewall
config_foreach add_clat_to_wan zone

[ "$CLAT_FW_CHANGED" = 1 ] && uci commit firewall
exit 0
