diff --git a/package/kernel/nat46/Makefile b/package/kernel/nat46/Makefile
index b6af9db655..2e5d262be8 100644
--- a/package/kernel/nat46/Makefile
+++ b/package/kernel/nat46/Makefile
@@ -14,6 +14,14 @@ PKG_LICENSE:=GPL-2.0
 
 PKG_BUILD_PARALLEL:=1
 
+# nat46 builds its module in the nat46/modules subdir, so the shared
+# symvers collector (Hooks/Compile/Post) must look there. On kernel 6.18
+# the Module.symvers format dropped the module path field, so the collector
+# falls back to modules.order — which only exists in this subdir. Without
+# this, symvers/nat46.symvers is staged empty and dependents (qca-nss
+# map-t connmgr) fail modpost with undefined nat46 exports.
+PKG_EXTMOD_SUBDIRS:=nat46/modules
+
 include $(INCLUDE_DIR)/package.mk
 
 define KernelPackage/nat46
